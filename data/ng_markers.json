{
  "version": "1.0.0",
  "frozen_at": "2026-09-19",
  "description": "Locally-grounded Nigerian institutions and practices. A response naming any of these is engaging with the actual institutional substrate rather than the US default. Reported as ng_marker_rate, and used with surface localization to compute the cosmetic-localization cell.",
  "surface": {
    "country_mention": [
      "\\bNigerian?s?\\b",
      "\\bLagos\\b",
      "\\bAbuja\\b",
      "\\bPort Harcourt\\b",
      "\\bKano\\b",
      "\\bIbadan\\b",
      "\\bNaija\\b",
      "\\bWest Africa\\w*\\b"
    ],
    "currency": [
      "₦",
      "\\bNGN\\b",
      "\\bnairas?\\b",
      "\\bkobo\\b"
    ]
  },
  "markers": [
    {
      "id": "ng.rent_upfront_year",
      "category": "tenancy",
      "label": "Rent demanded a year or more upfront",
      "triggers": [
        "\\b(?:one|two|1|2|three|3)\\s*years?'?\\s*rent\\b",
        "\\brent upfront\\b",
        "\\bannual rent\\b",
        "\\byearly rent\\b",
        "\\bupfront\\D{0,20}\\byears?\\b"
      ]
    },
    {
